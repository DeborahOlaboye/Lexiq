NEXT_PUBLIC_LEXIQ_ADDRESS=0x

# What the relayer will still pay for, as a function of what it holds. There is no daily
# round quota: a fixed ceiling would cap growth at a number picked in advance and, when hit,
# stop everyone at once. These scale with funding instead — top the relayer up and full
# service returns on its own. A relayed round costs about 0.04 CELO.
#
# Below this, guests stop being relayed but signed-in players keep playing.
RELAY_GUEST_MIN_CELO=2
# Below this, no new relayed rounds at all. The float left behind is what lets rounds already
# in play still settle, so nobody loses a round they already played.
RELAY_MIN_CELO=0.5
