# Copy to .env.production on the server and fill in real values.
# Never commit .env.production to git.
#
# Deploy with:  docker compose --env-file .env.production up -d --build
# The --env-file matters: NEXT_PUBLIC_* values are substituted into build args, and
# anything only present at runtime never reaches the browser bundle.

# ── Public (baked into the browser bundle at build time) ──
NEXT_PUBLIC_PRIVY_APP_ID=your_privy_app_id
# Lexiq v2 on Celo mainnet
NEXT_PUBLIC_LEXIQ_ADDRESS=0xC1224E01dbAfD97585Ac3f35DCb0291B1676d508

# ── Server-side secrets (never exposed to the browser) ──

# Signs score and seed attestations. Authoritative over scoring: whoever holds this key
# can forge any score. Must NOT be the relayer key. Needs no funding — it never sends
# a transaction. Rotate on-chain with setGameSigner() if it is ever exposed.
GAME_SIGNER_PRIVATE_KEY=0x...

# Sends the sponsored transactions. Fund with CELO — roughly 0.055 per free round.
RELAYER_PRIVATE_KEY=0x...

# Derives round seeds and guest addresses. Long random string (openssl rand -hex 32).
# Must never change once live: guest identities are derived from it, so rotating it
# silently gives every existing guest a new on-chain identity.
SEED_SECRET=

# Redis is supplied by the compose service; override only to point elsewhere.
# REDIS_URL=redis://redis:6379
