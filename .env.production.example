# Copy to .env.production on the server and fill in real values.
# Never commit .env.production to git.

# Privy — from https://dashboard.privy.io
NEXT_PUBLIC_PRIVY_APP_ID=your_privy_app_id

# Upstash Redis — from Vercel dashboard > Integrations > Upstash > .env.local tab
# (or create a new Redis DB at https://console.upstash.com)
KV_REST_API_URL=https://your-db.upstash.io
KV_REST_API_TOKEN=your_upstash_token

# Relayer wallet private key — funded with USDm for guest game gas (~$0.002/game)
RELAYER_PRIVATE_KEY=0xyour_relayer_private_key
